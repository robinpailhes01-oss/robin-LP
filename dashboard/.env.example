# Prospection Luma : noms des variables, sans valeurs.
# En session web, les renseigner dans les variables d'environnement de l'environnement cloud.
# Jamais dans le chat, jamais commitées.

# Récupération des leads
OUTSCRAPER_API_KEY=

# Envoi des mails (domaine robinpailhes.fr, déjà vérifié dans Resend)
RESEND_API_KEY=

# Expéditeur affiché et adresse qui reçoit les réponses (à confirmer par Robin)
SENDER_NAME=
SENDER_EMAIL=
REPLY_TO=

# Sécurité : reste à true tant que Robin n'a pas validé un lot
DRY_RUN=true

# Base Supabase (scripts et dashboard, côté serveur uniquement)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Mot de passe du dashboard (obligatoire dès que Supabase est branché)
DASHBOARD_PASSWORD=
