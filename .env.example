# Destinations des demandes du site (mini-audit, rappel, assistant). Voir app/api/contact/route.ts.
# Chaque destination est active si ses variables sont renseignées. Sans aucune, la demande est journalisée côté serveur.

# Supabase : table `leads` (supabase/migrations). Clé service = côté serveur uniquement, jamais en NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram : notification instantanée à chaque demande (rappels en tête).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Relais libre facultatif (email, CRM…), POST JSON.
CONTACT_WEBHOOK_URL=

# Studio privé (/studio) : le QG de l’agence, protégé par un seul mot de passe. Voir lib/studio/auth.ts.
# STUDIO_PASSWORD : 16 caractères minimum (en dessous, le studio refuse toute connexion), aléatoire de préférence,
# par exemple la sortie de `openssl rand -base64 24`.
STUDIO_PASSWORD=
# STUDIO_SECRET : facultatif, signe le cookie de session (à défaut, le mot de passe sert de clé).
# Le changer déconnecte toutes les sessions.
STUDIO_SECRET=
# Recommandé : dans Vercel > Firewall, une règle de limite de débit sur POST /api/studio/login
# (environ 10 requêtes par minute et par IP, action « deny » ou « challenge »). C’est un réglage du tableau de bord, pas du code.
